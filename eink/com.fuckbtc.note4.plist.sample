<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.fuckbtc.note4</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/mac26ai/Workspace/10_Code/P/btc-dashboard &amp;&amp; /Users/mac26ai/.npm-global/bin/vibe vault run --env ZECTRIX_API_KEY -- /usr/bin/python3 eink/push_note4.py --device-id "$ZECTRIX_DEVICE_ID"</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/mac26ai</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/mac26ai/.local/bin</string>
    <!-- Fill this with the NOTE4 MAC/deviceId after `GET /open/v1/devices`. -->
    <key>ZECTRIX_DEVICE_ID</key>
    <string>REPLACE_WITH_NOTE4_DEVICE_ID</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/mac26ai/Workspace/10_Code/P/btc-dashboard</string>
  <key>StandardOutPath</key>
  <string>/Users/mac26ai/Workspace/10_Code/P/btc-dashboard/eink/note4.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mac26ai/Workspace/10_Code/P/btc-dashboard/eink/note4.log</string>
</dict>
</plist>
